# Configuration inventory, NOT automatically loaded by Cargo, scripts or Actions.
# Export build inputs explicitly; provision GitHub vars/secrets in their documented
# scopes. Blank entries are placeholders, not usable defaults. No secrets here.
# Compile-time public configuration; missing/invalid values fail closed.
# Comma-separated approved Chrome IDs (32 lowercase a..p characters each).
SAFEAGENT_ALLOWED_EXTENSION_IDS=
# Comma-separated keyId:unpadded-base64url-Ed25519-public-key (32 bytes) entries.
# No whitespace, duplicate IDs, placeholder keys or private signing keys.
# Missing/malformed key ring rejects ALL authorization. Rebuild for rotation.
SAFEAGENT_AUTH_PUBLIC_KEYS=
# GitHub repository variable, NOT a runtime setting. Unset/false disables BOTH
# production signing and GitHub Release publication. Only exact true enables
# the existing protected-tag/environment gates. Internal Dev is independent.
SAFEAGENT_PRODUCTION_RELEASE_ENABLED=false
# safeagent-internal-dev environment must explicitly provision the two public
# variables above: identity EXACTLY khafofcbffjkkeeldejiplkfpdfckeol and an approved
# Dev key ring. No default key, fixture key or private key is supplied here.
# GitHub REPOSITORY variable: optional private Dev GCS upload job, default OFF.
# Requires dispatch publish_to_dev_gcs=true AND exact true here; does not enable
# production or backend download access. Configure environment gates first.
SAFEAGENT_DEV_GCS_PUBLICATION_ENABLED=false
# safeagent-internal-dev-publishing environment vars (not runtime dotenv):
# Repeat the SAME approved identity/key ring above; mismatch fails publication.
SAFEAGENT_DEV_GCP_PROJECT_ID=
# Bare private bucket name (no gs://, slash, dot or URL); enforced PAP + uniform IAM.
SAFEAGENT_DEV_GCS_BUCKET=
# projects/NUMBER/locations/global/workloadIdentityPools/POOL/providers/PROVIDER
SAFEAGENT_DEV_WIF_PROVIDER=
# safeagent-dev-uploader@PROJECT_ID.iam.gserviceaccount.com (no JSON key)
SAFEAGENT_DEV_UPLOAD_SERVICE_ACCOUNT=
# Dormant production safeagent-signing environment VARS; no defaults/fallbacks.
# Organization-approved RFC 3161 timestamp endpoint.
WINDOWS_TIMESTAMP_URL=
# Exact Developer ID Application and Developer ID Installer identity names.
MACOS_SIGNING_IDENTITY=
MACOS_INSTALLER_IDENTITY=
# safeagent-signing environment SECRETS: provision in GitHub, NEVER fill/commit
# real values in this file or a checked-in dotenv. See release.md for formats.
WINDOWS_CERTIFICATE_BASE64=
WINDOWS_CERTIFICATE_PASSWORD=
MACOS_CERTIFICATES_BASE64=
MACOS_CERTIFICATES_PASSWORD=
MACOS_KEYCHAIN_PASSWORD=
APPLE_API_KEY_BASE64=
APPLE_API_KEY_ID=
APPLE_API_ISSUER_ID=
# APPLE_API_KEY_PATH is generated by prepare-macos-signing.sh via GITHUB_ENV;
# not a repository input. GitHub supplies SOURCE_SHA (from dispatch), TARGET,
# GITHUB_* and RUNNER_TEMP to scripts; no user-provisioned defaults are needed.
# HIBU/backend integration flags belong to those apps' templates, not the host.
# Keep rollout OFF until separately approved; no legacy unauthenticated fallback.
# There are no native runtime enforcement/diagnostic/network flags.
